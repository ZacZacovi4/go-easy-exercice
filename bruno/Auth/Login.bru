meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{touristLogin}}",
    "password": "{{touristPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.data.token);
  }
}
