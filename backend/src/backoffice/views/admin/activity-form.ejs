<%- include('_head', { page: 'activities' }) %><a href="/admin/activities" class="back-link">← Activités</a>
<div class="form-card"><h1><%= activity && activity.id ? "Modifier l'activité" : "Nouvelle activité" %></h1><% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<form action="<%= activity && activity.id ? '/admin/activities/' + activity.id + '/edit' : '/admin/activities' %>" method="post">
<div class="field"><label>Titre</label><input name="title" required value="<%= activity ? activity.title : '' %>"></div>
<div class="field"><label>Description</label><textarea name="description" required><%= activity ? activity.description : '' %></textarea></div>
<div class="form-row"><div class="field"><label>Ville</label><input name="city" required value="<%= activity ? activity.city : '' %>"></div><div class="field"><label>Catégorie</label><input name="category" required value="<%= activity ? activity.category : '' %>"></div></div>
<div class="field"><label>Point de rendez-vous</label><input name="meetingPoint" required value="<%= activity ? activity.meetingPoint : '' %>"></div>
<div class="form-row"><div class="field"><label>Date et heure</label><input type="datetime-local" name="startDate" required value="<%= activity && activity.startDate ? new Date(activity.startDate).toISOString().slice(0,16) : '' %>"></div><div class="field"><label>Durée (min)</label><input type="number" name="durationMinutes" min="1" required value="<%= activity ? activity.durationMinutes : 90 %>"></div></div>
<div class="form-row"><div class="field"><label>Prix par personne (€)</label><input type="number" name="pricePerPerson" min="0" step="0.01" required value="<%= activity ? activity.pricePerPerson : 0 %>"></div><div class="field"><label>Capacité</label><input type="number" name="capacity" min="1" required value="<%= activity ? activity.capacity : 10 %>"></div></div>
<div class="field"><label>URL de l'image</label><input type="url" name="imageUrl" value="<%= activity ? activity.imageUrl : '' %>"></div><div class="form-actions"><button class="btn btn-primary">Enregistrer</button><a href="/admin/activities" class="btn btn-secondary">Annuler</a></div></form></div><%- include('_foot') %>
